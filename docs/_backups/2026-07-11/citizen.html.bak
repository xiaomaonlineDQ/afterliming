// Tab 4: 实战面板 — 完整JS逻辑
// ============================================================

// ============ 游戏状态机 ============
const PLAYER_NAMES = ['你(乐天派)', '法医侦探', '街道主任', '零零后', '记者', '黑客'];
const PLAYER_AVATARS = ['😄', '🔍', '🏛️', '⚡', '📷', '💻'];
const PHASE_ORDER = ['dawn', 'day', 'dusk', 'night'];
const PHASE_LABELS = {
  dawn:  { label: '🌅 黎明', cls: 'dawn' },
  day:   { label: '☀️ Day',  cls: 'day' },
  dusk:  { label: '🌆 黄昏', cls: 'dusk' },
  night: { label: '🌙 黑夜', cls: 'night' }
};

// 完整游戏状态
let GS = {
  round: 1,
  phase: 'day',
  phaseIdx: 0,
  currentPlayerIdx: 0,
  myIdx: 0,
  players: [],    // [{ name, avatar, health, maxHealth, sanity, maxSanity, gold, status, actionUsed }]
  handCards: [],  // 我的手牌（反击卡）
  activeCards: [],// 已激活的反击卡
  supplyInv: [],  // 物资库存
  damageCards: [],// 伤害指示卡 [{ type:'health'|'sanity', amount, img }]
  selectedCardIdx: -1,
  declareUsed: false,
  supplyUsed: false,
  skillUsed: false,
  lastHealth: 7,
  lastSanity: 7,
  lastGold: 50
};

// ============ 卡牌索引 ============
let CARD_INDEX = [];
let RULES_POOL = [];     // 可用规则卡池
let SUPPLY_DECK = [];    // 物资牌池
let COUNTER_DECK = [];   // 反击牌池

// ============ 初始化 ============
function initPlayPanel() {
  buildCardIndex();
  buildRulesPool();
  initGameState();
  buildSupplyDeck();
  buildCounterDeck();
  updateAllUI();
  addGameLog('系统', '🕹️ 实战面板已就绪 — 点击"下一回合"开始模拟');
}

function buildCardIndex() {
  if (CARD_INDEX.length > 0) return;
  if (typeof CARD_DB === 'undefined') return;

  const types = [
    { key: 'countermeasures', type: '反击卡', typeCss: 't-counter' },
    { key: 'whispers', type: '怪谈卡', typeCss: 't-whisper' },
    { key: 'supplies', type: '物资卡', typeCss: 't-supply' },
    { key: 'rules', type: '规则卡', typeCss: 't-rule' },
    { key: 'characters', type: '角色卡', typeCss: 't-character' },
    { key: 'personal_goals', type: '个人目的卡', typeCss: 't-goal' }
  ];

  types.forEach(t => {
    const cards = CARD_DB[t.key] || [];
    cards.forEach(c => {
      CARD_INDEX.push({
        id: c.id,
        name: c.name,
        type: t.type,
        typeKey: t.key,
        typeCss: t.typeCss,
        level: c.level || '',
        effect: c.effect || c.description || '',
        img: (typeof getCardImagePath === 'function')
          ? getCardImagePath({ type: t.key, level: c.level, name: c.name })
          : ''
      });
    });
  });
}

function buildRulesPool() {
  if (RULES_POOL.length > 0) return;
  const rules = (CARD_DB && CARD_DB.rules) ? CARD_DB.rules : [];
  RULES_POOL = rules.slice(0, 12).map(r => ({
    id: r.id, name: r.name, effect: r.effect || r.description || '',
    img: (typeof getCardImagePath === 'function')
      ? getCardImagePath({ type: 'rules', level: r.level, name: r.name })
      : ''
  }));
  if (RULES_POOL.length === 0) {
    // 后备：构造示例数据
    RULES_POOL = [
      { id:'r1', name:'不能说出"谢谢"', effect:'任何玩家说出"谢谢"时，立即受到1点健康值伤害。', img:'' },
      { id:'r2', name:'不能单独行动', effect:'任何玩家不得独自离开当前地点。', img:'' },
      { id:'r3', name:'不能认可的表达', effect:'玩家不能口头表达对他人行为或言论的认可。', img:'' },
      { id:'r4', name:'不可回头', effect:'玩家移动时不可返回上一地点。', img:'' },
      { id:'r5', name:'不可直视', effect:'玩家之间不可直视超过3秒。', img:'' },
      { id:'r6', name:'不可拒绝', effect:'任何玩家不得拒绝他人的合理请求。', img:'',
        effect:'任何玩家不得拒绝他人的合理请求。' }
    ];
  }
}

function buildSupplyDeck() {
  if (SUPPLY_DECK.length > 0) return;
  const supplies = (CARD_DB && CARD_DB.supplies) ? CARD_DB.supplies : [];
  SUPPLY_DECK = supplies.slice(0, 10).map(s => ({
    id: s.id, name: s.name, level: s.level || '', type: 'supply',
    effect: s.effect || s.description || '',
    healHP: (s.effect || '').includes('健康') ? (parseInt((s.effect||'').match(/(\d+)/)?.[1]) || 1) : 0,
    healSP: (s.effect || '').includes('理智') ? (parseInt((s.effect||'').match(/(\d+)/)?.[1]) || 1) : 0,
    goldCost: s.cost || 0,
    img: (typeof getCardImagePath === 'function')
      ? getCardImagePath({ type: 'supplies', level: s.level, name: s.name })
      : ''
  }));
}

function buildCounterDeck() {
  if (COUNTER_DECK.length > 0) return;
  const counters = (CARD_DB && CARD_DB.countermeasures) ? CARD_DB.countermeasures : [];
  COUNTER_DECK = counters.slice(0, 15).map(c => ({
    id: c.id, name: c.name, level: c.level || '', type: 'countermeasure',
    effect: c.effect || c.description || '',
    img: (typeof getCardImagePath === 'function')
      ? getCardImagePath({ type: 'countermeasures', level: c.level, name: c.name })
      : ''
  }));
}

function initGameState() {
  GS.players = PLAYER_NAMES.map((name, i) => ({
    name: name,
    avatar: PLAYER_AVATARS[i],
    health: i === 0 ? 6 : 7,
    maxHealth: 7,
    sanity: i === 0 ? 7 : 7,
    maxSanity: 7,
    gold: 50 + i * 5,
    maxGold: 200,
    status: 'alive',
    actionUsed: { declare: false, supply: false, skill: false }
  }));
  GS.myIdx = 0;
  GS.currentPlayerIdx = 0;
  GS.round = 1;
  GS.phase = 'day';
  GS.phaseIdx = 1;

  // 初始手牌（3张反击卡）
  if (COUNTER_DECK.length >= 3) {
    GS.handCards = COUNTER_DECK.slice(0, 3).map(c => ({...c}));
  }

  // 初始物资
  if (SUPPLY_DECK.length >= 3) {
    GS.supplyInv = SUPPLY_DECK.slice(0, 3).map(s => ({...s}));
  }

  // 示例：添加一张伤害卡
  GS.damageCards = [];

  GS.activeCards = [];
  GS.selectedCardIdx = -1;
  GS.declareUsed = false;
  GS.supplyUsed = false;
  GS.skillUsed = false;
  GS.lastHealth = GS.players[0].health;
  GS.lastSanity = GS.players[0].sanity;
  GS.lastGold = GS.players[0].gold;
}

// ============ 主渲染 ============
function updateAllUI() {
  updateTurnIndicator();
  updatePlayerList();
  updateHandStrip();
  updateActiveArea();
  updateStatusPanel();
  updateActionButtons();
}

function updateTurnIndicator() {
  document.getElementById('tiRoundNum').textContent = GS.round;
  const p = PHASE_LABELS[GS.phase] || PHASE_LABELS.day;
  const phaseEl = document.getElementById('tiPhase');
  phaseEl.textContent = p.label;
  phaseEl.className = 'ti-phase ' + p.cls;

  const isMyTurn = (GS.currentPlayerIdx === GS.myIdx);
  const playerEl = document.getElementById('tiPlayer');
  if (isMyTurn) {
    playerEl.classList.add('active-turn');
    document.getElementById('tiName').textContent = '你的回合';
    document.getElementById('tiAvatar').innerHTML = '<span style="font-size:0.7rem;">'+PLAYER_AVATARS[GS.myIdx]+'</span>';
  } else {
    playerEl.classList.remove('active-turn');
    const cp = GS.players[GS.currentPlayerIdx];
    document.getElementById('tiName').textContent = cp ? cp.name + ' 行动中' : '等待中…';
    document.getElementById('tiAvatar').innerHTML = '<span style="font-size:0.7rem;">' + (cp ? cp.avatar : '⏳') + '</span>';
  }
}

// ============ 玩家列表 ============
function updatePlayerList() {
  const list = document.getElementById('playerList');
  list.innerHTML = GS.players.map((p, i) => {
    let cls = 'player-dot';
    if (i === GS.currentPlayerIdx) cls += ' current';
    if (i === GS.myIdx) cls += ' me';
    const hpPct = Math.max(0, p.health / p.maxHealth * 100);
    const hpColor = p.health <= 2 ? '#e74c3c' : p.health <= 4 ? '#f39c12' : 'var(--success)';
    const statusIcon = p.status === 'ghost' ? ' 👻' : p.status === 'evil' ? ' 💀' : p.status === 'dead' ? ' ✝' : '';
    return '<div class="player-dot ' + cls + '">' +
      '<span class="pd-avatar">' + p.avatar + '</span>' +
      '<span class="pd-name">' + p.name.replace('你(', '').replace(')', '') + statusIcon + '</span>' +
      '<div class="pd-hp"><div class="pd-hp-fill" style="width:' + hpPct + '%;background:' + hpColor + ';"></div></div>' +
      '</div>';
  }).join('');
}

// ============ 手牌展示 ============
function updateHandStrip() {
  const strip = document.getElementById('handStrip');
  const count = GS.handCards.length;
  document.getElementById('handCount').textContent = count + ' / 3 张';

  if (count === 0) {
    strip.innerHTML = '<div class="hand-empty">暂无手牌 · 等待分发</div>';
    document.getElementById('handDetailMini').style.display = 'none';
    GS.selectedCardIdx = -1;
  } else {
    strip.innerHTML = GS.handCards.map((c, i) => {
      const sel = i === GS.selectedCardIdx ? ' selected' : '';
      return '<div class="hand-card' + sel + '" onclick="selectHandCard(' + i + ')" title="' + c.name + ' · ' + c.level + '">' +
        '<img src="' + (c.img || '') + '" alt="' + c.name + '" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\';">' +
        '<div style="display:none;width:100%;height:100%;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a1a2e,#16213e);color:var(--color-counter-glow);font-size:0.7rem;text-align:center;padding:4px;">🃏<br>' + c.name + '</div>' +
        '<div class="hand-card-overlay"><div class="hand-card-name">' + c.name + '</div><div class="hand-card-type">' + (c.level || '') + '</div></div>' +
        '</div>';
    }).join('');
  }

  if (GS.selectedCardIdx >= 0 && GS.selectedCardIdx < count) {
    showHandDetail(GS.selectedCardIdx);
  }
}

function selectHandCard(idx) {
  const max = GS.handCards.length;
  GS.selectedCardIdx = (idx >= 0 && idx < max && GS.selectedCardIdx !== idx) ? idx : -1;
  updateHandStrip();
}

function showHandDetail(idx) {
  const c = GS.handCards[idx];
  if (!c) { document.getElementById('handDetailMini').style.display = 'none'; return; }

  const panel = document.getElementById('handDetailMini');
  panel.style.display = 'flex';
  document.getElementById('hdmName').textContent = c.name;
  document.getElementById('hdmLevel').textContent = (c.level || '基础') + ' · 反击卡';
  document.getElementById('hdmEffect').textContent = c.effect || '效果描述待加载';

  const thumb = document.getElementById('hdmThumb');
  thumb.innerHTML = '<img src="' + (c.img || '') + '" alt="' + c.name + '" onerror="this.style.display=\'none\';this.parentElement.innerHTML=\'<span style=font-size:2rem;opacity:0.4>🃏</span>\';">';

  const btn = document.getElementById('hdmActivateBtn');
  btn.disabled = !isMyTurn();
  btn.textContent = '激活';
  btn.onclick = activateHandCard;
}

function activateHandCard() {
  const idx = GS.selectedCardIdx;
  if (idx < 0 || idx >= GS.handCards.length) return;

  const card = GS.handCards.splice(idx, 1)[0];
  GS.activeCards.push(card);
  GS.selectedCardIdx = -1;
  updateAllUI();
  addGameLog('行动', '已激活「' + card.name + '」→ 进入已激活区，等待发动时机');
}

// ============ 已激活区 ============
function updateActiveArea() {
  const area = document.getElementById('activeArea');
  const strip = document.getElementById('activeStrip');
  const count = GS.activeCards.length;
  document.getElementById('activeCount').textContent = count + ' 张';

  if (count === 0) {
    area.style.display = 'none';
    return;
  }
  area.style.display = 'block';

  strip.innerHTML = GS.activeCards.map((c, i) =>
    '<div class="hand-card" title="' + c.name + ' · 已激活 · 等待发动">' +
      '<img src="' + (c.img || '') + '" alt="' + c.name + '" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'flex\';">' +
      '<div style="display:none;width:100%;height:100%;align-items:center;justify-content:center;background:linear-gradient(135deg,#1a2e1a,#0f3460);color:var(--success);font-size:0.7rem;text-align:center;padding:4px;">✅<br>' + c.name + '</div>' +
      '<div class="hand-card-overlay"><div class="hand-card-name">' + c.name + '</div><div class="hand-card-type">' + (c.level || '已激活') + '</div></div>' +
    '</div>'
  ).join('');
}

// ============ 回合按钮 ============
function updateActionButtons() {
  const myTurn = isMyTurn();
  const me = GS.players[GS.myIdx];
  const alive = me && me.status === 'alive';

  document.getElementById('btnDeclare').disabled = GS.declareUsed || !myTurn || !alive;
  document.getElementById('btnSupply').disabled = GS.supplyUsed || !myTurn || !alive;
  document.getElementById('btnSkill').disabled = GS.skillUsed || !myTurn || !alive;
}

function isMyTurn() {
  return GS.currentPlayerIdx === GS.myIdx && GS.players[GS.myIdx].status === 'alive';
}

// ============ 行动：宣言抹除规则 ============
function declareAction() {
  if (!isMyTurn() || GS.declareUsed) return;
  hideSupplySelector();

  const sel = document.getElementById('declareSelector');
  const grid = document.getElementById('declareGrid');

  if (sel.style.display === 'block') {
    hideDeclareSelector();
    return;
  }

  // 目标玩家列表（排除自己 + 死亡玩家）
  const targets = GS.players.filter((p, i) =>
    i !== GS.myIdx && (p.status === 'alive' || p.status === 'ghost')
  );

  grid.innerHTML = '<div class="selector-header" style="margin-bottom:8px;">' +
    '<span style="font-size:0.75rem;color:var(--text-muted);">选择要抹除的规则 + 指向的玩家</span></div>' +
    RULES_POOL.map((r, ri) => {
      let html = '<div class="selector-item" style="width:auto;text-align:left;" onclick="showDeclareModal(' + ri + ')">' +
        '<div style="display:flex;align-items:center;gap:8px;padding:8px;cursor:pointer;border-radius:var(--radius-sm);margin-bottom:4px;">' +
        '<span style="font-size:0.82rem;font-weight:600;color:var(--color-rule-glow);">' + r.name + '</span>' +
        '<span style="font-size:0.65rem;color:var(--text-muted);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + (r.effect||'').substring(0,30) + '</span>' +
        '</div></div>';
      return html;
    }).join('');
  sel.style.display = 'block';
  sel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function showDeclareModal(ruleIdx) {
  const rule = RULES_POOL[ruleIdx];
  if (!rule) return;

  // 可选目标玩家
  const targets = GS.players.filter((p, i) =>
    i !== GS.myIdx && (p.status === 'alive' || p.status === 'ghost')
  );

  const overlay = document.createElement('div');
  overlay.className = 'declare-modal';
  overlay.id = 'declareModalOverlay';
  overlay.innerHTML =
    '<div class="dm-dialog">' +
      '<div class="dm-title">📢 宣言抹除规则</div>' +
      '<div class="dm-subtitle">规则：<b style="color:var(--color-rule-glow)">' + rule.name + '</b></div>' +
      '<div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:8px;padding:8px;background:var(--bg-deep);border-radius:var(--radius-sm);">' + (rule.effect || '无描述') + '</div>' +
      '<div style="font-size:0.72rem;color:var(--text-muted);margin-bottom:8px;">选择这条规则指向的目标玩家：</div>' +
      '<div class="dm-targets" id="dmTargets">' +
        targets.map((t, i) =>
          '<div class="dm-target" id="dmTarget' + i + '" onclick="selectDeclareTarget(' + ruleIdx + ',' + i + ')">' +
            '<div class="dm-radio"></div>' +
            '<div><div class="dm-target-name">' + t.avatar + ' ' + t.name + '</div>' +
            '<div class="dm-target-hint">HP:' + t.health + '/' + t.maxHealth + ' SP:' + t.sanity + '/' + t.maxSanity + '</div></div>' +
          '</div>'
        ).join('') +
      '</div>' +
      '<div class="dm-actions">' +
        '<button class="dm-btn cancel" onclick="document.getElementById(\'declareModalOverlay\').remove()">取消</button>' +
        '<button class="dm-btn primary" id="dmConfirmBtn" disabled onclick="confirmDeclare(' + ruleIdx + ')">确认宣言</button>' +
      '</div>' +
    '</div>';
  overlay.onclick = function(e) {
    if (e.target === overlay) overlay.remove();
  };
  document.body.appendChild(overlay);
}

let selectedDeclareTarget = -1;
function selectDeclareTarget(ruleIdx, targetIdx) {
  selectedDeclareTarget = targetIdx;
  document.querySelectorAll('.dm-target').forEach(el => el.classList.remove('selected'));
  const el = document.getElementById('dmTarget' + targetIdx);
  if (el) el.classList.add('selected');
  const btn = document.getElementById('dmConfirmBtn');
  if (btn) btn.disabled = false;
}

function confirmDeclare(ruleIdx) {
  if (selectedDeclareTarget < 0) return;

  const rule = RULES_POOL[ruleIdx];
  const targets = GS.players.filter((p, i) => i !== GS.myIdx && (p.status === 'alive' || p.status === 'ghost'));
  const target = targets[selectedDeclareTarget];

  document.getElementById('declareModalOverlay').remove();
  hideDeclareSelector();
  GS.declareUsed = true;

  // 模拟市长判定（75%成功率）
  const success = Math.random() > 0.25;
  if (success) {
    addGameLog('行动', '📢 宣言「' + rule.name + '」指向「' + target.name + '」→ ✅ 市长判定：宣言成立！规则被抹除');
    // 奖励：抽一张反击卡
    if (COUNTER_DECK.length > GS.handCards.length + GS.activeCards.length) {
      const newCard = COUNTER_DECK[GS.handCards.length + GS.activeCards.length];
      GS.handCards.push({...newCard});
      addGameLog('系统', '🎁 宣言成功奖励 → 获得「' + newCard.name + '」');
    }
  } else {
    addGameLog('危险', '📢 宣言「' + rule.name + '」→ ❌ 市长判定：宣言失败！理智-1');
    applyStatusChange('sanity', -1);
  }

  selectedDeclareTarget = -1;
  updateAllUI();
}

function hideDeclareSelector() {
  document.getElementById('declareSelector').style.display = 'none';
}

// ============ 行动：使用物资 ============
function useSupply() {
  if (!isMyTurn() || GS.supplyUsed) return;
  hideDeclareSelector();

  const sel = document.getElementById('supplySelector');
  if (sel.style.display === 'block') {
    hideSupplySelector();
    return;
  }

  const grid = document.getElementById('supplyGrid');
  if (GS.supplyInv.length === 0) {
    grid.innerHTML = '<div class="selector-empty">暂无可用物资</div>';
  } else {
    grid.innerHTML = GS.supplyInv.map((s, i) =>
      '<div class="selector-item" onclick="useSupplyItem(' + i + ')" title="' + (s.effect||'') + '">' +
        '<div class="si-thumb"><img src="' + (s.img||'') + '" alt="' + s.name + '" onerror="this.style.display=\'none\';this.parentElement.innerHTML=\'<span style=font-size:2rem;opacity:0.4>🎒</span>\';"></div>' +
        '<div class="si-name">' + s.name + '</div>' +
        '<div class="si-effect">' + (s.effect||'').substring(0,20) + '</div>' +
        '</div>'
    ).join('');
  }
  sel.style.display = 'block';
  sel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function useSupplyItem(idx) {
  const item = GS.supplyInv[idx];
  if (!item) return;

  GS.supplyInv.splice(idx, 1);
  GS.supplyUsed = true;

  // 应用效果
  let effectDesc = '';
  if (item.healHP > 0) {
    applyStatusChange('health', item.healHP);
    effectDesc += '健康+' + item.healHP + ' ';
  }
  if (item.healSP > 0) {
    applyStatusChange('sanity', item.healSP);
    effectDesc += '理智+' + item.healSP + ' ';
  }
  if (!item.healHP && !item.healSP) {
    // 其他效果（描述性）
    effectDesc = item.effect || '效果已应用';
  }

  hideSupplySelector();
  updateAllUI();
  addGameLog('行动', '🎒 使用「' + item.name + '」→ ' + effectDesc);
}

function hideSupplySelector() {
  document.getElementById('supplySelector').style.display = 'none';
}

// ============ 行动：角色技能 ============
function useSkill() {
  if (!isMyTurn() || GS.skillUsed) return;

  GS.skillUsed = true;
  const me = GS.players[GS.myIdx];

  // 乐天派技能：本回合宣言+1次机会（额外宣言）
  addGameLog('行动', '⭐ 乐天派技能发动 → 本回合宣言次数+1');
  // 重置宣言状态
  GS.declareUsed = false;

  updateAllUI();
}

// ============ 结束回合 ============
function endTurn() {
  showConfirm('确认结束回合？',
    '结束回合后进入下一玩家回合。你的行动机会将被重置。',
    function() {
      addGameLog('系统', '⏭️ ' + GS.players[GS.myIdx].name + ' 结束回合');
      advancePlayerTurn();
    });
}

function passAction() {
  showConfirm('确认跳过行动？',
    '跳过本次行动机会，回合仍属于你。',
    function() {
      // 直接推进到下一个玩家（跳过当前玩家剩余操作）
      addGameLog('系统', '⏸️ ' + GS.players[GS.myIdx].name + ' 跳过行动');
      advancePlayerTurn();
    });
}

// ============ 回合推进 ============
function advancePlayerTurn() {
  // 寻找下一个存活的玩家
  let next = (GS.currentPlayerIdx + 1) % GS.players.length;
  let tries = 0;
  while (GS.players[next].status === 'dead' && tries < GS.players.length) {
    next = (next + 1) % GS.players.length;
    tries++;
  }

  // 检查是否需要推进阶段/回合
  if (next <= GS.currentPlayerIdx && GS.currentPlayerIdx >= GS.players.length - 1) {
    advancePhase();
  }

  GS.currentPlayerIdx = next;

  // 重置当前玩家的行动状态
  const cp = GS.players[next];
  cp.actionUsed = { declare: false, supply: false, skill: false };

  // 如果下一个是"我"，重置我的操作状态
  if (next === GS.myIdx) {
    GS.declareUsed = false;
    GS.supplyUsed = false;
    GS.skillUsed = false;
  }

  updateAllUI();
}

function advancePhase() {
  GS.phaseIdx = (GS.phaseIdx + 1) % 4;
  GS.phase = PHASE_ORDER[GS.phaseIdx];

  if (GS.phase === 'dawn') {
    GS.round++;
    // 黎明结算
    applyDawnSettlement();
  }

  addGameLog('系统', '⏰ 进入 → ' + PHASE_LABELS[GS.phase].label +
    (GS.phase === 'dawn' ? ' 第' + GS.round + '回合' : ''));
}

function applyDawnSettlement() {
  const me = GS.players[GS.myIdx];
  // 黎明健康值递减（从第1回合开始逐渐递减，这里模拟）
  const dawnDrain = GS.round <= 3 ? 0 : GS.round <= 6 ? 1 : 2;
  if (dawnDrain > 0) {
    applyStatusChange('health', -dawnDrain);
    addGameLog('危险', '🌅 黎明结算 → 健康值-' + dawnDrain + '（第' + GS.round + '回合）');
  }
}

// ============ 数值动画 ============
function applyStatusChange(type, delta) {
  const me = GS.players[GS.myIdx];
  const oldVal = type === 'health' ? me.health : type === 'sanity' ? me.sanity : me.gold;
  const maxVal = type === 'health' ? me.maxHealth : type === 'sanity' ? me.maxSanity : me.maxGold;
  const newVal = Math.max(0, Math.min(maxVal, oldVal + delta));

  if (type === 'health') {
    GS.lastHealth = oldVal;
    me.health = newVal;
  } else if (type === 'sanity') {
    GS.lastSanity = oldVal;
    me.sanity = newVal;
  } else {
    GS.lastGold = oldVal;
    me.gold = newVal;
  }

  // 触发数值动画
  animateStatusBar(type, oldVal, newVal, maxVal);

  // 检查死亡
  if (me.health <= 0 || me.sanity <= 0) {
    handlePlayerDeath();
  }
}

function animateStatusBar(type, from, to, max) {
  const elId = type === 'health' ? 'siHealth' : type === 'sanity' ? 'siSanity' : 'siGold';
  const barId = type === 'health' ? 'siHealthBar' : type === 'sanity' ? 'siSanityBar' : 'siGoldBar';

  const el = document.getElementById(elId);
  const bar = document.getElementById(barId);
  if (!el || !bar) return;

  const fromPct = from / max * 100;
  const toPct = to / max * 100;
  const steps = 10;
  const duration = 300;
  let step = 0;

  function tick() {
    step++;
    const progress = step / steps;
    const eased = progress * progress; // easeInQuad
    const cur = from + (to - from) * eased;
    const curPct = fromPct + (toPct - fromPct) * eased;

    el.textContent = Math.round(cur);
    bar.style.width = curPct + '%';

    // 颜色变化
    if (type === 'health') {
      el.style.color = cur <= 2 ? '#e74c3c' : cur <= 4 ? '#f39c12' : 'var(--success)';
    } else if (type === 'sanity') {
      el.style.color = cur <= 2 ? '#e74c3c' : cur <= 4 ? '#f39c12' : 'var(--color-character-glow)';
    }

    if (step < steps) {
      requestAnimationFrame(tick);
    } else {
      el.textContent = to;
      bar.style.width = toPct + '%';
    }
  }
  requestAnimationFrame(tick);
}

function handlePlayerDeath() {
  const me = GS.players[GS.myIdx];
  if (me.status === 'alive') {
    me.status = 'ghost';
    addGameLog('危险', '💀 你已化为煞鬼！现在你可以激活怪谈卡对抗存活玩家');
    // 简化：保持幽灵状态
  }
}

// ============ 状态面板 ============
function updateStatusPanel() {
  const me = GS.players[GS.myIdx];

  document.getElementById('siHealth').textContent = me.health;
  document.getElementById('siHealthBar').style.width = (me.health / me.maxHealth * 100) + '%';
  document.getElementById('siSanity').textContent = me.sanity;
  document.getElementById('siSanityBar').style.width = (me.sanity / me.maxSanity * 100) + '%';
  document.getElementById('siGold').textContent = me.gold;
  document.getElementById('siGoldBar').style.width = Math.min(me.gold / me.maxGold * 100, 100) + '%';

  const statusEl = document.getElementById('siStatusText');
  statusEl.textContent = me.status === 'alive' ? '存活' : me.status === 'ghost' ? '煞鬼' : me.status === 'evil' ? '恶鬼' : '死亡';
  statusEl.className = 'si-value ' + me.status;
}

// ============ 搜索框 ============
let searchFocusedIdx = -1;
let searchResults = [];

function onCardSearch(value) {
  const q = value.trim().toLowerCase();
  const suggest = document.getElementById('searchSuggestions');
  const clearBtn = document.getElementById('searchClear');

  if (q.length === 0) {
    suggest.classList.remove('show');
    suggest.innerHTML = '';
    clearBtn.classList.remove('visible');
    searchResults = [];
    searchFocusedIdx = -1;
    return;
  }

  clearBtn.classList.add('visible');
  searchResults = CARD_INDEX.filter(c =>
    c.name.toLowerCase().includes(q) ||
    (c.effect && c.effect.toLowerCase().includes(q))
  ).slice(0, 20);
  searchFocusedIdx = -1;

  if (searchResults.length === 0) {
    suggest.innerHTML = '<div class="search-empty">没有找到匹配的卡牌</div>';
  } else {
    suggest.innerHTML = searchResults.map((c, i) =>
      '<div class="search-suggestion-item" id="sugItem' + i + '" onclick="selectSuggestion(' + i + ')" onmouseenter="focusSuggestion(' + i + ')">' +
        '<div class="ssi-thumb"><img src="' + c.img + '" alt="' + c.name + '" onerror="this.style.background=\'var(--bg-card)\';this.alt=\'\';">' +
        '</div><div class="ssi-info">' +
          '<div class="ssi-name">' + c.name + '</div>' +
          '<div class="ssi-meta"><span class="ssi-type ' + c.typeCss + '">' + c.type + '</span>' + (c.level ? '<span>' + c.level + '</span>' : '') + '</div>' +
        '</div></div>'
    ).join('');
  }
  suggest.classList.add('show');
}

function focusSuggestion(idx) {
  document.querySelectorAll('.search-suggestion-item').forEach(el => el.classList.remove('focused'));
  const el = document.getElementById('sugItem' + idx);
  if (el) el.classList.add('focused');
  searchFocusedIdx = idx;
}

function handleSearchKey(event) {
  const suggest = document.getElementById('searchSuggestions');
  if (!suggest.classList.contains('show') || searchResults.length === 0) return;

  if (event.key === 'ArrowDown') {
    event.preventDefault();
    searchFocusedIdx = Math.min(searchFocusedIdx + 1, searchResults.length - 1);
    focusSuggestion(searchFocusedIdx);
  } else if (event.key === 'ArrowUp') {
    event.preventDefault();
    searchFocusedIdx = Math.max(searchFocusedIdx - 1, 0);
    focusSuggestion(searchFocusedIdx);
  } else if (event.key === 'Enter') {
    event.preventDefault();
    if (searchFocusedIdx >= 0) selectSuggestion(searchFocusedIdx);
  } else if (event.key === 'Escape') {
    clearSearch();
  }
}

function selectSuggestion(idx) {
  const card = searchResults[idx];
  if (!card) return;

  if (card.type === '反击卡' && GS.handCards.length < 5) {
    const exists = GS.handCards.find(c => c.name === card.name);
    if (!exists) {
      GS.handCards.push({ id: card.id, name: card.name, type: 'countermeasure', level: card.level, effect: card.effect, img: card.img });
      addGameLog('系统', '搜索添加「' + card.name + '」→ 加入手牌');
    }
  }
  if (card.type === '物资卡' && GS.supplyInv.length < 8) {
    const exists = GS.supplyInv.find(s => s.name === card.name);
    if (!exists) {
      GS.supplyInv.push({ id: card.id, name: card.name, level: card.level, effect: card.effect, img: card.img, healHP: 0, healSP: 0 });
      addGameLog('系统', '搜索添加「' + card.name + '」→ 加入物资');
    }
  }
  document.getElementById('cardSearchInput').value = card.name;
  clearSearch();
  updateAllUI();
}

function clearSearch() {
  document.getElementById('cardSearchInput').value = '';
  document.getElementById('searchClear').classList.remove('visible');
  document.getElementById('searchSuggestions').classList.remove('show');
  document.getElementById('searchSuggestions').innerHTML = '';
  searchResults = [];
  searchFocusedIdx = -1;
}

document.addEventListener('click', function(e) {
  const wrap = document.getElementById('searchWrap');
  if (wrap && !wrap.contains(e.target)) {
    document.getElementById('searchSuggestions').classList.remove('show');
  }
});

// ============ 确认对话框 ============
function showConfirm(title, body, onConfirm) {
  const overlay = document.createElement('div');
  overlay.className = 'confirm-overlay';
  overlay.innerHTML =
    '<div class="confirm-dialog">' +
      '<div class="cd-title">' + title + '</div>' +
      '<div class="cd-body">' + body + '</div>' +
      '<div class="cd-actions">' +
        '<button class="cd-btn cancel">取消</button>' +
        '<button class="cd-btn confirm">确认</button>' +
      '</div></div>';
  document.body.appendChild(overlay);

  overlay.querySelector('.cancel').onclick = function() { overlay.remove(); };
  overlay.querySelector('.confirm').onclick = function() {
    overlay.remove();
    if (onConfirm) onConfirm();
  };
  overlay.onclick = function(e) {
    if (e.target === overlay) overlay.remove();
  };
}

// ============ 日志 ============
function addGameLog(type, text) {
  const log = document.getElementById('gameLog');
  const now = new Date();
  const time = now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
  const cssMap = { '行动': 'log-action', '危险': 'log-danger', '系统': 'log-system' };
  const cssCls = cssMap[type] || '';

  const line = document.createElement('div');
  line.className = 'log-line';
  line.innerHTML = '<span class="log-time">' + time + '</span><span class="log-text ' + cssCls + '">' + text + '</span>';
  log.appendChild(line);
  log.scrollTop = log.scrollHeight;

  while (log.children.length > 80) {
    log.removeChild(log.firstChild);
  }
}

// ============ 键盘快捷键 ============
document.addEventListener('keydown', function(e) {
  // 只在实战面板激活时响应
  const panel = document.getElementById('panel-play');
  if (!panel || !panel.classList.contains('active')) return;
  // 如果在搜索输入框中，不拦截
  if (document.activeElement && document.activeElement.id === 'cardSearchInput') return;
  // 如果有modal打开，不拦截
  if (document.querySelector('.confirm-overlay, .declare-modal')) return;

  switch(e.key.toLowerCase()) {
    case 'd':
      e.preventDefault();
      declareAction();
      break;
    case 's':
      e.preventDefault();
      useSupply();
      break;
    case 'k':
      e.preventDefault();
      useSkill();
      break;
    case 'e':
      e.preventDefault();
      endTurn();
      break;
    case ' ':
      e.preventDefault();
      passAction();
      break;
    case 'arrowright':
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        advancePlayerTurn();
      }
      break;
  }
});
</script>

</body>
</html>
